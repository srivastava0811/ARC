APP_ENV=development
DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Keep fixture mode enabled until GEMINI_API_KEY has been configured.
AGENT_MODE=fixture
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
GEMINI_EVALUATOR_MODEL=gemini-3.5-flash
GEMINI_REPORTER_MODEL=gemini-3.5-flash-lite

# Product catalog provider. Channel3 mode never falls back to demo data.
CATALOG_PROVIDER=demo_catalog
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_SEARCH_LIMIT=12
# Review heuristic for new monitors, not a guaranteed market minimum.
# Offers below this USD unit price cannot be recommended or checked out.
CHANNEL3_MINIMUM_MONITOR_PRICE=50.00

# PayPal Sandbox only. Keep the secret server-side; never place it in frontend/.env.local.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
